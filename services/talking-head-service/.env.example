# Official LatentSync runtime configuration
MODEL_CACHE_DIR=/app/models
LATENTSYNC_CHECKPOINT_PATH=/app/models/latentsync/checkpoints/latentsync_unet.pt
LATENTSYNC_WHISPER_PATH=/app/models/latentsync/checkpoints/whisper/tiny.pt
LATENTSYNC_CONFIG_PATH=/app/models/latentsync/configs/unet/stage2_512.yaml
LATENTSYNC_SCHEDULER_CONFIG_PATH=/app/models/latentsync/configs/scheduler_config.json
LATENTSYNC_CONFIG_DIR=/app/models/latentsync/configs
LATENTSYNC_MODEL_REPO=ByteDance/LatentSync-1.6
TALKING_HEAD_DEVICE=cpu

# GPU example:
# TALKING_HEAD_DEVICE=cuda
# LATENTSYNC_CHECKPOINT_PATH=/app/models/latentsync/checkpoints/latentsync_unet.pt
# LATENTSYNC_WHISPER_PATH=/app/models/latentsync/checkpoints/whisper/tiny.pt
# LATENTSYNC_SCHEDULER_CONFIG_PATH=/app/models/latentsync/configs/scheduler_config.json
